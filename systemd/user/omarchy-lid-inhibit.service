[Unit]
Description=Omarchy Lid — keep working lid closed (inhibit handle-lid-switch)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=systemd-inhibit --what=handle-lid-switch --who="Omarchy Lid" --why="Keep working lid closed" sleep infinity
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
