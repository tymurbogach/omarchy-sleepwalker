[Unit]
Description=Omarchy Sleepwalker — keep working lid closed (inhibit handle-lid-switch)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=systemd-inhibit --what=handle-lid-switch --who="Omarchy Sleepwalker" --why="Keep working lid closed" sleep infinity
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
