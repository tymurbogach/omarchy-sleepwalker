#!/bin/bash
# Installed at ~/.config/omarchy/hooks/post-update.d/<slug>, where Omarchy runs
# it during `omarchy update`, once the new packages are in.
#
# Sleepwalker's bar icon lives inside a CLONE of Omarchy's own indicators
# widget, because that widget hardcodes its list and loads each entry from a
# path inside its own plugin directory — no external plugin can contribute one.
# A clone left alone is a frozen fork: it keeps whatever indicators Omarchy
# shipped the day it was made and never sees a fix again.
#
# So it is rebuilt from Omarchy's current source after every update, with
# Laptop.qml dropped back in. Nothing here is hand-edited and nothing needs
# backing up: this is the thing that reproduces it.
set -uo pipefail
command -v omarchy-sleepwalker >/dev/null 2>&1 || exit 0
SRC="$(dirname "$(readlink -f "$(command -v omarchy-sleepwalker)")")/.."
[[ -x "$SRC/install.sh" ]] || exit 0
"$SRC/install.sh" --sync >/dev/null 2>&1 || true
