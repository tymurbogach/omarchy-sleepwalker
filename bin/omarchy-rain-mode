#!/usr/bin/env bash

# Switch the Matrix rain between the ttfx terminal screensaver and the
# Enter the Matrix GPU plugin. Never both: the GPU overlay covers the
# terminal, so each switch disables the other side and restarts the shell,
# which is the only reliable QML reload.
#
# Usage: omarchy-rain-mode status | use-ttfx | use-gpu
#   status   prints "ttfx" or "gpu" on stdout, exit 0
#   use-ttfx disables the GPU plugin, keeps ttfx, restarts the shell
#   use-gpu  enables the GPU plugin (ttfx stays installed but covered), restarts

set -euo pipefail

GPU_ID="io.github.tymurbogach.enter-the-matrix"
OMARCHY_BIN="${OMARCHY_BIN:-/usr/share/omarchy/bin/omarchy}"
[[ -x $OMARCHY_BIN ]] || OMARCHY_BIN="omarchy"

mode() {
  local enabled
  enabled=$("$OMARCHY_BIN" plugin list --json 2>/dev/null | jq -r --arg id "$GPU_ID" '.[] | select(.id == $id) | .enabled' | head -1)
  if [[ $enabled == "true" ]]; then
    echo "gpu"
  else
    echo "ttfx"
  fi
}

case "${1:-}" in
  status)
    mode
    ;;
  use-ttfx)
    if [[ $(mode) != "ttfx" ]]; then
      "$OMARCHY_BIN" plugin disable "$GPU_ID"
    fi
    "$OMARCHY_BIN" restart shell
    ;;
  use-gpu)
    if [[ $(mode) != "gpu" ]]; then
      "$OMARCHY_BIN" plugin enable "$GPU_ID"
    fi
    "$OMARCHY_BIN" restart shell
    ;;
  *)
    echo "Usage: omarchy-rain-mode status | use-ttfx | use-gpu" >&2
    exit 1
    ;;
esac
