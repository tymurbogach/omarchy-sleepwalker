#!/usr/bin/env bash
# Select the installed Matrix screensaver renderer.
set -euo pipefail
GPU_ID="io.github.tymurbogach.enter-the-matrix"

mode() {
  local list enabled
  list=$(omarchy plugin list --json) || { echo "Cannot query plugins" >&2; return 1; }
  enabled=$(jq -r --arg id "$GPU_ID" '.[] | select(.id == $id) | .enabled' <<<"$list") || {
    echo "Matrix GPU plugin is not installed" >&2; return 1;
  }
  case "$enabled" in
    true) echo gpu ;;
    false) echo ttfx ;;
    *) echo "Matrix GPU plugin is not installed" >&2; return 1 ;;
  esac
}

case "${1:-}" in
  status) mode ;;
  use-ttfx)
    if [[ $(mode) != ttfx ]]; then omarchy plugin disable "$GPU_ID"; fi
    ;;
  use-gpu)
    if [[ $(mode) != gpu ]]; then omarchy plugin enable "$GPU_ID"; fi
    ;;
  *) echo "Usage: omarchy-rain-mode status | use-ttfx | use-gpu" >&2; exit 1 ;;
esac
