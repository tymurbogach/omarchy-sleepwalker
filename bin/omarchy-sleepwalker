#!/bin/bash
# omarchy-sleepwalker — keep working with lid closed
#   omarchy-sleepwalker status [--json]
#   omarchy-sleepwalker lid on|off|toggle
#   omarchy-sleepwalker lock on|off|toggle
#   omarchy-sleepwalker doctor
#
# State (single source of truth, shared with Service.qml + Laptop indicator):
#   ~/.local/state/omarchy/toggles/sleepwalker — presence = lid-ignore on (preferred)
#   ~/.local/state/omarchy/toggles/lid-ignore  — presence = same, legacy (read, migrated away on write)
#   ~/.local/state/omarchy/toggles/lid-lock    — presence = also lock on lid close (opt-in)
#
# The inhibitor itself is held by the plugin's Service.qml as a child
# `systemd-inhibit … sleep infinity` while the toggle is on — no systemd unit,
# so `omarchy plugin add` alone is a working install.

set -euo pipefail

SELF=$(basename "$0")
ID="io.github.tymurbogach.sleepwalker"
TOGGLES_DIR="$HOME/.local/state/omarchy/toggles"
TOGGLE_IGNORE="$TOGGLES_DIR/sleepwalker"
TOGGLE_IGNORE_LEGACY="$TOGGLES_DIR/lid-ignore"
TOGGLE_LOCK="$TOGGLES_DIR/lid-lock"
INHIBIT_WHO="Omarchy Sleepwalker"
LEGACY_UNITS=("omarchy-sleepwalker-inhibit.service" "omarchy-lid-inhibit.service")

fail() { echo "$SELF: $*" >&2; exit 1; }

is_ignore_on() { [[ -f $TOGGLE_IGNORE || -f $TOGGLE_IGNORE_LEGACY ]]; }
is_lock_on()   { [[ -f $TOGGLE_LOCK ]]; }

# The Service-held inhibitor shows in logind with our --who string.
is_inhibit_active() {
  systemd-inhibit --list 2>/dev/null | grep -qF "$INHIBIT_WHO"
}

set_lid() {
  local action="$1"
  case "$action" in
    on)
      mkdir -p "$TOGGLES_DIR"
      touch "$TOGGLE_IGNORE"
      rm -f "$TOGGLE_IGNORE_LEGACY"
      ;;
    off)
      rm -f "$TOGGLE_IGNORE" "$TOGGLE_IGNORE_LEGACY"
      ;;
    toggle|"")
      if is_ignore_on; then set_lid off; else set_lid on; fi
      ;;
    *) fail "lid: expected on|off|toggle, got '$action'" ;;
  esac
}

set_lock() {
  local action="$1"
  case "$action" in
    on)
      mkdir -p "$TOGGLES_DIR"
      touch "$TOGGLE_LOCK"
      ;;
    off)
      rm -f "$TOGGLE_LOCK"
      ;;
    toggle|"")
      if is_lock_on; then set_lock off; else set_lock on; fi
      ;;
    *) fail "lock: expected on|off|toggle, got '$action'" ;;
  esac
}

service_loaded() {
  # NOTE: `omarchy shell <target> <method>` is the routed form; the bare
  # `omarchy-shell shell …` variant answers "Function not found" for targets.
  omarchy shell sleepwalker status 2>/dev/null | grep -q '"active"'
}

cmd_status() {
  local json=false
  [[ ${1:-} == "--json" ]] && json=true

  local active inhibit lock
  is_ignore_on && active=true || active=false
  is_inhibit_active && inhibit=true || inhibit=false
  is_lock_on && lock=true || lock=false

  if $json; then
    printf '{"active":%s,"inhibitActive":%s,"lockOnLid":%s}\n' "$active" "$inhibit" "$lock"
  else
    printf 'lid-ignore: %s\n' "$([ "$active" = true ] && echo on || echo off)"
    printf 'inhibit:    %s\n' "$([ "$inhibit" = true ] && echo active || echo inactive)"
    printf 'lock-on-lid:%s\n' "$([ "$lock" = true ] && echo on || echo off)"
    if [[ $active == true && $inhibit == false ]]; then
      echo "warning: toggle on but inhibitor inactive — run: $SELF doctor" >&2
    fi
    if [[ $active == false && $inhibit == true ]]; then
      echo "warning: inhibitor active but toggle off — run: $SELF doctor" >&2
    fi
  fi
}

cmd_doctor() {
  local active inhibit
  is_ignore_on && active=true || active=false
  is_inhibit_active && inhibit=true || inhibit=false
  echo "· lid-ignore: $active, inhibit: $inhibit, lock-on-lid: $(is_lock_on && echo on || echo off)"

  # Legacy (<0.2.0) systemd units: the Service owns the inhibitor now.
  local u leftovers=false
  for u in "${LEGACY_UNITS[@]}"; do
    if [[ -f $HOME/.config/systemd/user/$u ]]; then
      echo "· removing legacy unit $u (Service holds the inhibitor now)"
      systemctl --user disable --now "$u" >/dev/null 2>&1 || systemctl --user stop "$u" >/dev/null 2>&1 || true
      rm -f "$HOME/.config/systemd/user/$u"
      leftovers=true
    fi
  done
  $leftovers && systemctl --user daemon-reload >/dev/null 2>&1 || true

  if [[ $active == true && $inhibit == false ]]; then
    if service_loaded; then
      echo "· service is loaded but holds no inhibitor — restarting shell to recover"
      omarchy-restart-shell >/dev/null 2>&1 || true
    else
      echo "· fixing: plugin service not loaded — enabling $ID"
      omarchy plugin enable "$ID" >/dev/null 2>&1 || echo "· enable it with: omarchy plugin enable $ID" >&2
    fi
  elif [[ $active == false && $inhibit == true ]]; then
    echo "· stray inhibitor with toggle off — it belongs to a dying shell; restarting shell to release it"
    omarchy-restart-shell >/dev/null 2>&1 || true
  else
    echo "· in sync"
  fi
  echo "· ok"
}

usage() {
  cat <<USAGE
Usage: $SELF <command> [args]

  status [--json]          show lid state
  lid on|off|toggle        inhibit lid suspend (keep working closed)
  lock on|off|toggle       lock on lid close when lid-ignore is on (default off)
  doctor                   reconcile toggle vs inhibitor, drop legacy units
USAGE
}

# --- dispatch ---

case "${1:-status}" in
  status) shift || true; cmd_status "${1:-}" ;;
  lid)    shift || true; set_lid "${1:-toggle}"; cmd_status --json >/dev/null; echo "lid $(is_ignore_on && echo on || echo off)" ;;
  lock)   shift || true; set_lock "${1:-toggle}"; echo "lock-on-lid $(is_lock_on && echo on || echo off)" ;;
  doctor) cmd_doctor ;;
  -h|--help|help) usage ;;
  *) echo "unknown command: $1" >&2; usage; exit 1 ;;
esac
